{
  "name": "presentations",
  "compatibility_date": "2026-10-02",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Slidev builds an SPA whose 404.html is a copy of index.html, so the
    // nearest-404 fallback hands deep links (/placement/presenter, /placement/3)
    // back to the deck's own router. "single-page-application" would serve the
    // root index.html instead, which breaks once there is more than one deck.
    "not_found_handling": "404-page",
    // Without this the asset router answers /__sync with a 404 page and the
    // WebSocket upgrade never reaches the Worker.
    "run_worker_first": ["/__sync"]
  },
  "durable_objects": {
    "bindings": [{ "name": "SYNC", "class_name": "SyncRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SyncRoom"] }
  ],
  "routes": [
    { "pattern": "presentation.lancy.dev", "custom_domain": true }
  ]
}
